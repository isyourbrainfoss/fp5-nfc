# Kernel config fragment for Fairphone 5 NFC (ST21NFCD via st-nci, I2C).
#
# Merge with: scripts/kconfig/merge_config.sh .config kconfig/nfc.config
#
# The "st,st21nfcd" compatible also needs the staged raw-NCI patch
# (upstream/st21nfcd-v5/0002). Without it these options build a driver
# that does not bind to the FP5 node.
CONFIG_NFC=m
CONFIG_NFC_NCI=m
# NFC_ST_NCI is a hidden symbol. NFC_ST_NCI_I2C selects it.
CONFIG_NFC_ST_NCI_I2C=m
# Optional: SPI variant, and the HCI/SHDLC stack used by other ST parts.
# CONFIG_NFC_ST_NCI_SPI=m
# CONFIG_NFC_HCI=m
#
# The DT node also needs these. They are already =y in the Nura
# linux-postmarketos-qcom-sc7280 config (7.2.9) and in BengalOS sc7280.config
# (7.2.8), checked 2026-11-11: I2C_QCOM_GENI, PINCTRL_SC7280,
# COMMON_CLK_QCOM, QCOM_CLK_RPMH, REGULATOR_QCOM_RPMH.
